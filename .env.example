# Claude API key (required for live processing of new enquiries)
ANTHROPIC_API_KEY=

# Models
CLASSIFY_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5

# Database (SQLite by default; set a Postgres URL to switch)
DATABASE_URL=sqlite:///./data/app.db

# LLM mode: "live" calls Claude on cache miss, "cache" only uses data/llm_cache.json
LLM_MODE=live

# Demo helpers: allows POST /api/admin/reset (used by the clip recorder)
DEMO_MODE=1

# Cap on live Claude calls per day (0 = no cap). Set this on public deployments.
DAILY_CALL_LIMIT=0
